# ReviewLens Environment Configuration Example
# Copy this file to .env and configure your keys

# AI Provider: "gemini", "groq", "openrouter", or "mock" (default fallback for offline testing/evaluation)
AI_PROVIDER=gemini

# Google Gemini API Key (Get free tier at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq API Key (Optional alternative - https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter API Key (Optional alternative - https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-flash-1.5

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Cache Configuration
CACHE_DB_PATH=backend/data/cache.db
